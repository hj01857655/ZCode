{
  "name": "@zcode/zcode-cua",
  "version": "0.6.6",
  "private": true,
  "description": "Computer Use producer package: vendored official client runtime (14 tools -> broker) plus the packaged Windows Helper runtime (ZCode 4.0.0 artifacts under dist/ and build/Release, declared via zcodeCuaRuntime).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./frame-contract": {
      "types": "./dist/frame-contract/index.d.ts",
      "import": "./dist/frame-contract/index.js"
    },
    "./host-display-contract": {
      "types": "./host-display-contract.d.ts",
      "import": "./host-display-contract.js"
    },
    "./request-access-contract": {
      "types": "./request-access-contract.d.ts",
      "import": "./request-access-contract.js"
    },
    "./pip-session": {
      "types": "./pip-session.d.ts",
      "import": "./pip-session.js"
    },
    "./pip-session/node": {
      "types": "./pip-session-node.d.ts",
      "import": "./pip-session-node.js"
    },
    "./broker": {
      "types": "./broker.d.ts",
      "import": "./broker.js"
    },
    "./broker/server": {
      "types": "./broker-server.d.ts",
      "import": "./broker-server.js"
    },
    "./broker/in-process": {
      "types": "./broker-in-process.d.ts",
      "import": "./broker-in-process.js"
    },
    "./broker/ports": {
      "types": "./broker-ports.d.ts",
      "import": "./broker-ports.js"
    },
    "./broker/socketPath": {
      "types": "./broker-socket-path.d.ts",
      "import": "./broker-socket-path.js"
    },
    "./broker/helperConstants": {
      "types": "./broker-helper-constants.d.ts",
      "import": "./broker-helper-constants.js"
    },
    "./broker/helperHealth": {
      "types": "./broker-helper-health.d.ts",
      "import": "./broker-helper-health.js"
    }
  },
  "zcodeCuaRuntime": {
    "schema": 1,
    "windows": {
      "entry": "dist/windows-helper.js",
      "nativeAddon": "build/Release/ax_native.node"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.5"
  },
  "zcodeCuaHelperRuntimeDependencies": [
    "express",
    "sharp"
  ]
}
